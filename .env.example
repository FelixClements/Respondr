# Server
NODE_ENV=development
PORT=9595
# Bind address. Empty = 127.0.0.1 in development, 0.0.0.0 in production.
# Setting HOST=0.0.0.0 in development requires SETUP_TOKEN for HTTP /setup.
HOST=
# Set to true when running behind a trusted reverse proxy (e.g. Caddy, Traefik, Nginx)
# to trust X-Forwarded-For / X-Real-IP headers for client IP rate limiting.
# Ensure your proxy strips or overwrites BOTH client-supplied X-Forwarded-For
# (e.g. proxy_set_header X-Forwarded-For $remote_addr) AND X-Real-IP
# (e.g. proxy_set_header X-Real-IP $remote_addr). The app trusts the rightmost
# valid X-Forwarded-For entry, falling back to X-Real-IP only when valid.
TRUST_PROXY=

# Better Auth
# Development: http://localhost is fine. Production: must be https://your-public-hostname
BETTER_AUTH_URL=http://localhost:9595
# Generate with: openssl rand -base64 32 (required, unique, 32+ chars in production)
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32

# First-boot security (production)
# Option A: pre-create admin at container boot (recommended for Docker)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Option B: allow HTTP /setup only when this token is sent (X-Setup-Token header)
# Generate with: openssl rand -base64 32
SETUP_TOKEN=

# Scanner
SCAN_INTERVAL_MINUTES=30
CHAT_LIMIT=50
THRESHOLD_HOURS=3

# Notifications (used to pre-fill notification settings on first run; can also be set in the dashboard)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_PRIORITY=3

GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5

# PWA Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:respondr@example.com

# Puppeteer executable path (use a dedicated Chromium, not your personal Chrome)
# Docker Compose sets this to /usr/bin/chromium — you can leave it unset in .env for Docker.
# Linux (bare metal): /usr/bin/chromium or /usr/bin/chromium-browser
# macOS:              /Applications/Chromium.app/Contents/MacOS/Chromium
PUPPETEER_EXECUTABLE_PATH=/Applications/Chromium.app/Contents/MacOS/Chromium
# Extra Chromium flags (quote args with spaces, e.g. PUPPETEER_ARGS="--user-data-dir='/path with spaces/x'")
#PUPPETEER_ARGS=
# WhatsApp session storage (LocalAuth dataPath). Compose mounts a named volume here.
#AUTH_DIR=./.wwebjs_auth
