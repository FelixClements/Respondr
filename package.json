{
  "name": "respondr",
  "version": "0.2.0",
  "description": "WhatsApp Response Reminder Engine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "concurrently -n server,web -c blue,green \"tsx watch src/index.ts\" \"npm run dev --prefix web\"",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "build:web": "npm run build --prefix web",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:migrate": "npx auth@latest migrate --config ./better-auth.config.ts --yes",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "whatsapp",
    "reminder",
    "notifications"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "axios": "1.18.1",
    "better-auth": "^1.2.8",
    "better-sqlite3": "12.11.1",
    "dotenv": "16.4.7",
    "hono": "4.12.30",
    "node-cron": "4.6.0",
    "qrcode": "1.5.4",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
