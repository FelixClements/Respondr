<h2>Logs</h2>
<p>Current level: <strong><%= (settings.log_level || 'info').toUpperCase() %></strong></p>

<form method="POST" action="/logs">
  <label>
    Minimum log level
    <select name="log_level">
      <% ['debug','info','warn','error'].forEach(level => { %>
        <option value="<%= level %>" <%= settings.log_level === level ? 'selected' : '' %>><%= level.toUpperCase() %></option>
      <% }) %>
    </select>
  </label>
  <button type="submit">Set level</button>
</form>

<div id="log-container">
  <% logs.forEach(log => { %>
    <div class="log-entry log-<%= log.level %>">
      <span class="log-ts"><%= new Date(log.ts).toISOString() %></span>
      <span class="log-level"><%= log.level.toUpperCase() %></span>
      <span class="log-message"><%= log.message %></span>
    </div>
  <% }) %>
</div>

<script>
  async function refreshLogs() {
    try {
      const res = await fetch('/api/logs');
      const data = await res.json();
      const container = document.getElementById('log-container');
      container.innerHTML = data.logs.map((log) => {
        const ts = new Date(log.ts).toISOString();
        const message = String(log.message).replace(/&/g, '&amp;').replace(/</g, '&lt;');
        return `<div class="log-entry log-${log.level}"><span class="log-ts">${ts}</span><span class="log-level">${log.level.toUpperCase()}</span><span class="log-message">${message}</span></div>`;
      }).join('');
      container.scrollTop = container.scrollHeight;
    } catch (e) {
      // ignore polling errors
    }
  }

  refreshLogs();
  setInterval(refreshLogs, 3000);
</script>
