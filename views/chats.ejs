<%
function formatAgo(hours) {
  if (hours === null || hours === undefined) return '—';
  const h = Math.floor(hours);
  const m = Math.floor((hours - h) * 60);
  if (h >= 24) {
    const d = Math.floor(h / 24);
    const rh = h % 24;
    return `${d}d ${rh}h`;
  }
  return `${h}h ${m}m`;
}

function getState(chat) {
  if (!chat.state) return null;
  return typeof chat.state === 'string' ? chat.state : chat.state.state;
}

function getUntil(chat) {
  return chat.state && typeof chat.state === 'object' ? chat.state.until : null;
}

function badgeHtml(state, needsReply) {
  if (state === 'ignored') return '<span class="badge ignored">Ignored</span>';
  if (state === 'done') return '<span class="badge done">Done</span>';
  if (needsReply) return '<span class="badge needs-reply">Needs reply</span>';
  return '<span class="badge ok">OK</span>';
}

function escapeHtml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function actionForms(chat) {
  const state = getState(chat);
  const id = encodeURIComponent(chat.id);
  const name = escapeHtml(chat.name || chat.id);
  const check = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>';
  const undo = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.793 2.232a.75.75 0 01-.025 1.06L3.622 7.25h10.003a.75.75 0 010 1.5H3.622l4.146 3.957a.75.75 0 01-1.036 1.085l-5.5-5.25a.75.75 0 010-1.085l5.5-5.25a.75.75 0 011.06.025z" clip-rule="evenodd"/></svg>';
  const eye = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"/><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41zM15 10a5 5 0 11-10 0 5 5 0 0110 0z" clip-rule="evenodd"/></svg>';
  const eyeSlash = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2.695 14.3l1.66-1.66a4.5 4.5 0 010-6.364l-1.66-1.66A6.98 6.98 0 000 10c0 1.953.796 3.72 2.083 4.996L2.695 14.3zm10.6-10.6l1.66 1.66a4.5 4.5 0 010 6.364l1.66 1.66A6.98 6.98 0 0020 10c0-1.953-.796-3.72-2.083-4.996l-1.66 1.66zM10 5a5 5 0 00-5 5 5 5 0 005 5 5 5 0 005-5 5 5 0 00-5-5zm0 8a3 3 0 01-3-3 3 3 0 013-3 3 3 0 013 3 3 3 0 01-3 3z"/><path d="M1.293 1.293a1 1 0 011.414 0l16 16a1 1 0 01-1.414 1.414l-16-16a1 1 0 010-1.414z"/></svg>';

  if (state === 'ignored') {
    return `<form method="POST" action="/chats/${id}/unignore" class="chat-action-form">
      <input type="hidden" name="name" value="${name}">
      <button type="submit" class="btn btn-icon btn-ghost" title="Unignore" aria-label="Unignore">${eye}</button>
    </form>
    <form method="POST" action="/chats/${id}/done" class="chat-action-form">
      <input type="hidden" name="name" value="${name}">
      <button type="submit" class="btn btn-icon btn-primary" title="Mark done" aria-label="Mark done">${check}</button>
    </form>`;
  }

  if (state === 'done') {
    return `<form method="POST" action="/chats/${id}/undone" class="chat-action-form">
      <input type="hidden" name="name" value="${name}">
      <button type="submit" class="btn btn-icon btn-ghost" title="Undo done" aria-label="Undo done">${undo}</button>
    </form>
    <form method="POST" action="/chats/${id}/ignore" class="chat-action-form">
      <input type="hidden" name="name" value="${name}">
      <button type="submit" class="btn btn-icon btn-ghost" title="Ignore" aria-label="Ignore">${eyeSlash}</button>
    </form>`;
  }

  return `<form method="POST" action="/chats/${id}/done" class="chat-action-form">
    <input type="hidden" name="name" value="${name}">
    <button type="submit" class="btn btn-icon btn-primary" title="Mark done" aria-label="Mark done">${check}</button>
  </form>
  <form method="POST" action="/chats/${id}/ignore" class="chat-action-form">
    <input type="hidden" name="name" value="${name}">
    <button type="submit" class="btn btn-icon btn-ghost" title="Ignore" aria-label="Ignore">${eyeSlash}</button>
  </form>`;
}

const total = chats.length;
const urgent = chats.filter(c => c.needsReply).length;
const snoozed = chats.filter(c => {
  const s = getState(c);
  return s === 'ignored' || s === 'done';
}).length;
const sorted = chats.slice().sort((a, b) => {
  if (a.needsReply && !b.needsReply) return -1;
  if (!a.needsReply && b.needsReply) return 1;
  return (b.hoursSince || 0) - (a.hoursSince || 0);
});
%>

<div class="page-header">
  <h2>Chats</h2>
  <p>Recent WhatsApp conversations and reply status</p>
</div>

<section class="metrics" aria-label="Chat metrics">
  <article class="metric">
    <div class="metric-value"><%= total %></div>
    <div class="metric-label">Total active</div>
  </article>
  <article class="metric <%= urgent > 0 ? 'urgent' : '' %>">
    <div class="metric-value" data-metric="urgent"><%= urgent %></div>
    <div class="metric-label">Urgent / Overdue</div>
  </article>
  <article class="metric">
    <div class="metric-value" data-metric="snoozed"><%= snoozed %></div>
    <div class="metric-label">Ignored / Done</div>
  </article>
  <article class="metric">
    <div class="metric-value" data-next-scan="<%= typeof nextScan !== 'undefined' && nextScan ? new Date(nextScan).toISOString() : '' %>" data-countdown>—</div>
    <div class="metric-label">Next scan</div>
  </article>
</section>

<% if (error) { %>
  <div class="card error"><%= error %></div>
<% } %>

<% if (chats.length === 0 && !error) { %>
  <div class="card empty-state">
    <svg class="empty-state-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h3>No chats found</h3>
    <p>WhatsApp may not be linked yet. <a href="/qr">Link your account</a> to start scanning.</p>
  </div>
<% } %>

<% if (urgent === 0 && chats.length > 0) { %>
  <div class="card empty-state">
    <svg class="empty-state-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h3>All caught up!</h3>
    <p>No chats are currently overdue for a reply. The latest conversations are below.</p>
  </div>
<% } %>

<% if (chats.length > 0) { %>
  <section class="chat-list" role="list" aria-label="Chat list">
    <% sorted.forEach(chat => { %>
      <% const state = getState(chat); const until = getUntil(chat); %>
      <article class="chat-card" data-chat-id="<%= chat.id %>" data-chat-name="<%= chat.name || chat.id %>" data-state="<%= state || '' %>" data-needs-reply="<%= chat.needsReply ? '1' : '' %>">
        <div class="chat-main">
          <div class="chat-avatar" aria-hidden="true"><%= (chat.name || chat.id).slice(0, 2).toUpperCase() %></div>
          <div class="chat-info">
            <div class="chat-name-row">
              <div class="chat-name"><%= chat.name || chat.id %></div>
              <div class="chat-status"><%- badgeHtml(state, chat.needsReply) %></div>
            </div>
            <div class="chat-meta">
              <% if (chat.lastMessage && !chat.lastMessage.fromMe) { %>
                <span class="time-ago">Waiting <%= formatAgo(chat.hoursSince) %></span>
              <% } else if (chat.lastMessage) { %>
                <span>Last message <%= formatAgo(chat.hoursSince) %> ago</span>
              <% } else { %>
                <span>No recent messages</span>
              <% } %>
              <% if (chat.lastMessage) { %>
                <span><%= chat.lastMessage.fromMe ? 'From you' : 'Inbound' %></span>
              <% } %>
              <% if (chat.lastMessage && chat.lastMessage.hasReactionFromMe) { %>
                <span class="reaction-tag">Reacted</span>
              <% } %>
            </div>
          </div>
          <div class="chat-actions" data-state="<%= state || '' %>">
            <%- actionForms(chat) %>
          </div>
        </div>
        <div class="chat-extras">
          <% if (state === 'done' && until) { %>
            <div class="state-note">Resets <%= new Date(until).toLocaleDateString() %> if no new reply</div>
          <% } else if (state === 'ignored') { %>
            <div class="state-note">Ignored until you change it</div>
          <% } %>
          <% if (chat.lastMessage && chat.lastMessage.hasReactionFromMe) { %>
            <div class="reaction-note">Your emoji reaction counts as a reply</div>
          <% } %>
        </div>
      </article>
    <% }) %>
  </section>
<% } %>
