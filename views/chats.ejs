<h2>Checked chats</h2>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (chats.length === 0) { %>
  <p>No chats found. Make sure WhatsApp is linked.</p>
<% } else { %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Last message</th>
          <th>From me</th>
          <th>Reacted</th>
          <th>Hours since</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% chats.forEach(chat => { %>
          <tr>
            <td><%= chat.name || chat.id %></td>
            <td>
              <% if (chat.lastMessage) { %>
                <%= new Date(chat.lastMessage.timestampMs).toLocaleString() %>
              <% } else { %>
                <em>unknown</em>
              <% } %>
            </td>
            <td>
              <% if (chat.lastMessage) { %>
                <%= chat.lastMessage.fromMe ? 'Yes' : 'No' %>
              <% } else { %>
                <em>—</em>
              <% } %>
            </td>
            <td>
              <% if (chat.lastMessage && chat.lastMessage.hasReactionFromMe) { %>
                Yes
              <% } else { %>
                No
              <% } %>
            </td>
            <td>
              <%= chat.hoursSince !== null ? chat.hoursSince : '—' %>
            </td>
            <td>
              <% if (chat.state === 'ignored') { %>
                <span class="badge ignored">ignored</span>
              <% } else if (chat.state === 'done') { %>
                <span class="badge done">done</span>
              <% } else if (chat.needsReply) { %>
                <span class="badge needs-reply">needs reply</span>
              <% } else { %>
                <span class="badge ok">ok</span>
              <% } %>
            </td>
            <td>
              <div class="action-group">
                <% if (chat.state === 'ignored') { %>
                  <form method="POST" action="/chats/<%= encodeURIComponent(chat.id) %>/unignore" class="inline-form">
                    <input type="hidden" name="name" value="<%= chat.name || chat.id %>">
                    <button type="submit" class="button-sm ghost">Unignore</button>
                  </form>
                  <form method="POST" action="/chats/<%= encodeURIComponent(chat.id) %>/done" class="inline-form">
                    <input type="hidden" name="name" value="<%= chat.name || chat.id %>">
                    <button type="submit" class="button-sm primary">Done</button>
                  </form>
                <% } else if (chat.state === 'done') { %>
                  <form method="POST" action="/chats/<%= encodeURIComponent(chat.id) %>/undone" class="inline-form">
                    <input type="hidden" name="name" value="<%= chat.name || chat.id %>">
                    <button type="submit" class="button-sm ghost">Undo</button>
                  </form>
                  <form method="POST" action="/chats/<%= encodeURIComponent(chat.id) %>/ignore" class="inline-form">
                    <input type="hidden" name="name" value="<%= chat.name || chat.id %>">
                    <button type="submit" class="button-sm ghost">Ignore</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/chats/<%= encodeURIComponent(chat.id) %>/done" class="inline-form">
                    <input type="hidden" name="name" value="<%= chat.name || chat.id %>">
                    <button type="submit" class="button-sm primary">Done</button>
                  </form>
                  <form method="POST" action="/chats/<%= encodeURIComponent(chat.id) %>/ignore" class="inline-form">
                    <input type="hidden" name="name" value="<%= chat.name || chat.id %>">
                    <button type="submit" class="button-sm ghost">Ignore</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
