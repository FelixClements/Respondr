<div class="page-header">
  <h2>Settings</h2>
  <p>Configure how Respondr scans your chats</p>
</div>

<div class="card">
  <h3>Core</h3>
  <form method="POST" action="/settings">
    <label>
      Scan interval (minutes)
      <input type="number" name="interval_minutes" value="<%= settings.interval_minutes %>" min="1" required>
    </label>
    <label>
      Chat limit
      <input type="number" name="chat_limit" value="<%= settings.chat_limit %>" min="1" required>
    </label>
    <label>
      Response threshold (hours)
      <input type="number" name="threshold_hours" value="<%= settings.threshold_hours %>" min="1" required>
    </label>
    <button type="submit" class="btn btn-primary">Save settings</button>
  </form>
</div>

<div class="mobile-only">
  <div class="card settings-tile" role="group" aria-label="Notifications">
    <h3>Notifications</h3>
    <a class="settings-link" href="/notifications">
      <span>Push, NTFY, and Gotify</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="settings-link-icon"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
    </a>
  </div>

  <div class="card settings-tile" role="group" aria-label="Advanced">
    <h3>Advanced</h3>
    <a class="settings-link" href="/logs">
      <span>Logs</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="settings-link-icon"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
    </a>
    <a class="settings-link" href="/history">
      <span>History</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="settings-link-icon"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
    </a>
  </div>
</div>
