<a class="settings-link mobile-only back-link" href="/settings">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="settings-link-icon back-link-icon"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
  <span>Back to Settings</span>
</a>

<div class="page-header">
  <h2>Notifications</h2>
  <p>Choose how Respondr alerts you</p>
</div>

<div class="card">
  <form method="POST" action="/notifications">
    <h3>NTFY</h3>
    <label class="checkbox-row">
      <input type="checkbox" name="ntfy_enabled" value="1" <%= settings.ntfy_enabled === '1' ? 'checked' : '' %>>
      Enable NTFY
    </label>
    <label>
      Server
      <input type="text" name="ntfy_server" value="<%= settings.ntfy_server || 'https://ntfy.sh' %>">
    </label>
    <label>
      Topic
      <input type="text" name="ntfy_topic" value="<%= settings.ntfy_topic || '' %>">
    </label>
    <label>
      Priority
      <input type="number" name="ntfy_priority" value="<%= settings.ntfy_priority || 3 %>" min="1" max="5">
    </label>

    <h3 style="margin-top:1.25rem">Gotify</h3>
    <label class="checkbox-row">
      <input type="checkbox" name="gotify_enabled" value="1" <%= settings.gotify_enabled === '1' ? 'checked' : '' %>>
      Enable Gotify
    </label>
    <label>
      URL
      <input type="text" name="gotify_url" value="<%= settings.gotify_url || '' %>">
    </label>
    <label>
      Token
      <input type="text" name="gotify_token" value="<%= settings.gotify_token || '' %>">
    </label>
    <label>
      Priority
      <input type="number" name="gotify_priority" value="<%= settings.gotify_priority || 5 %>" min="0" max="10">
    </label>

    <button type="submit" class="btn btn-primary">Save notifications</button>
  </form>
</div>

<div class="card" style="margin-top:1rem">
  <h3>Web Push</h3>
  <p class="muted">Status: <span id="push-status">Checking…</span></p>
  <button id="push-subscribe" class="btn btn-primary" type="button">Subscribe</button>
  <button id="push-test" class="btn btn-ghost" type="button">Send test push</button>
  <pre id="push-test-result" class="code-block" style="display:none"></pre>
</div>

<div class="card" style="margin-top:1rem">
  <h3>Test NTFY/Gotify</h3>
  <button id="test-notification" class="btn btn-ghost" type="button">Send test notification</button>
  <pre id="test-result" class="code-block" style="display:none"></pre>
</div>

<script>
  document.getElementById('test-notification').addEventListener('click', async () => {
    const el = document.getElementById('test-result');
    el.textContent = 'Sending...';
    el.style.display = 'block';
    try {
      const res = await fetch('/api/test-notification', { method: 'POST' });
      const data = await res.json();
      el.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      el.textContent = 'Error: ' + err.message;
    }
  });
</script>
