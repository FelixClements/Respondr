<div class="page-header">
  <h2>Ignored Chats</h2>
  <p>Conversations you have paused reminders for</p>
</div>

<div class="card">
  <% if (ignored.length === 0) { %>
    <div class="empty-state small">
      <p>No chats are being ignored.</p>
    </div>
  <% } else { %>
    <ul class="list-stack">
      <% ignored.forEach(chat => { %>
        <li class="list-item">
          <span class="list-title"><%= chat.name %></span>
          <form method="POST" action="/ignored/<%= encodeURIComponent(chat.id) %>/delete" class="inline-form">
            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
