<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0B0F19">
  <title><%= title || 'Respondr' %></title>
  <link rel="stylesheet" href="/static/style.css?v=4">
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <span class="brand-dot" aria-hidden="true"></span>
          Respondr
        </a>
        <% if (user) { %>
          <div class="topbar-right">
            <span id="connection-badge" class="status-badge initializing">Checking…</span>
            <span class="user-pill">
              <%= user %>
              <form method="POST" action="/logout" class="inline-form">
                <button type="submit" class="btn btn-ghost btn-sm">Logout</button>
              </form>
            </span>
            <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="main-nav" type="button">
              <span></span>
              <span></span>
              <span></span>
            </button>
          </div>
        <% } %>
      </div>
      <% if (user) { %>
        <nav class="nav-row" id="main-nav" aria-label="Main">
          <div class="nav-inner">
            <a class="nav-link" href="/">Dashboard</a>
            <a class="nav-link" href="/chats">Chats</a>
            <a class="nav-link" href="/qr">Link</a>
            <a class="nav-link" href="/settings">Settings</a>
            <a class="nav-link" href="/notifications">Notifications</a>
            <a class="nav-link" href="/logs">Logs</a>
            <a class="nav-link" href="/ignored">Ignored</a>
            <a class="nav-link" href="/history">History</a>
          </div>
        </nav>
        <script>
          (function () {
            const toggle = document.getElementById('nav-toggle');
            const nav = document.getElementById('main-nav');
            if (!toggle || !nav) return;
            toggle.addEventListener('click', () => {
              const open = toggle.getAttribute('aria-expanded') === 'true';
              toggle.setAttribute('aria-expanded', String(!open));
              nav.classList.toggle('open', !open);
            });
          })();
        </script>
      <% } %>
    </header>
    <main>
      <%- body %>
    </main>
    <div id="toast-container"></div>
  </div>
  <script src="/static/status.js?v=4"></script>
  <script src="/static/app.js?v=1"></script>
</body>
</html>
