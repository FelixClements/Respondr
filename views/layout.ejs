<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Respondr' %></title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header>
    <h1>Respondr</h1>
    <% if (user) { %>
      <div id="status-bar">
        <div>
          <span id="status-indicator">checking...</span>
          <span id="status-icons"></span>
        </div>
        <span class="user-info">
          <%= user %>
          <form method="POST" action="/logout" class="inline-form"><button type="submit">Logout</button></form>
        </span>
      </div>
      <nav>
        <a href="/">Dashboard</a>
        <a href="/chats">Chats</a>
        <a href="/qr">QR</a>
        <a href="/settings">Settings</a>
        <a href="/notifications">Notifications</a>
        <a href="/logs">Logs</a>
        <a href="/ignored">Ignored</a>
        <a href="/history">History</a>
      </nav>
    <% } %>
  </header>
  <main>
    <%- body %>
  </main>
  <script src="/static/status.js?v=2"></script>
</body>
</html>
