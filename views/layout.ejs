<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#4f46e5">
  <title><%= title || 'Respondr' %></title>
  <link rel="stylesheet" href="/static/style.css?v=2">
</head>
<body>
  <header>
    <div class="header-top">
      <h1>Respondr</h1>
      <% if (user) { %>
        <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="main-nav" type="button">
          <span></span>
          <span></span>
          <span></span>
        </button>
      <% } %>
    </div>
    <% if (user) { %>
      <div id="status-bar">
        <div>
          <span id="status-indicator">checking...</span>
          <span id="status-icons"></span>
        </div>
        <span class="user-info">
          <%= user %>
          <form method="POST" action="/logout" class="inline-form"><button type="submit" class="button-ghost">Logout</button></form>
        </span>
      </div>
      <nav id="main-nav" aria-label="Main">
        <a href="/">Dashboard</a>
        <a href="/chats">Chats</a>
        <a href="/qr">QR</a>
        <a href="/settings">Settings</a>
        <a href="/notifications">Notifications</a>
        <a href="/logs">Logs</a>
        <a href="/ignored">Ignored</a>
        <a href="/history">History</a>
      </nav>
      <script>
        (function () {
          const toggle = document.getElementById('nav-toggle');
          const nav = document.getElementById('main-nav');
          if (!toggle || !nav) return;
          toggle.addEventListener('click', () => {
            const open = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!open));
            nav.classList.toggle('open', !open);
          });
        })();
      </script>
    <% } %>
  </header>
  <main>
    <%- body %>
  </main>
  <script src="/static/status.js?v=3"></script>
</body>
</html>
