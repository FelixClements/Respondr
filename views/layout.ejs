<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0B0F19">
  <meta name="vapid-public-key" content="<%= vapidPublicKey || '' %>">
  <link rel="manifest" href="/manifest.json?v=2">
  <link rel="apple-touch-icon" href="/icon-192.png">
  <title><%= title || 'Respondr' %></title>
  <script>
    (function () {
      const stored = localStorage.getItem('respondr-theme');
      const prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
      const theme = stored || (prefersLight ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="stylesheet" href="/static/style.css?v=5">
  <link rel="stylesheet" href="/static/mobile.css?v=1">
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <span class="brand-dot" aria-hidden="true"></span>
          Respondr
        </a>
        <div class="topbar-right">
          <button id="theme-toggle" class="btn btn-ghost btn-icon" type="button" aria-label="Toggle theme" title="Toggle theme">
            <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" style="display:none">
              <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
            </svg>
            <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
            </svg>
          </button>
          <button id="pwa-install" class="btn btn-ghost btn-sm" type="button" style="display:none">Install app</button>
          <% if (user) { %>
            <span id="connection-badge" class="status-badge initializing">Checking…</span>
            <span class="user-pill">
              <%= user %>
              <form method="POST" action="/logout" class="inline-form">
                <button type="submit" class="btn btn-ghost btn-sm">Logout</button>
              </form>
            </span>
            <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="main-nav" type="button">
              <span></span>
              <span></span>
              <span></span>
            </button>
          <% } %>
        </div>
      </div>
      <% if (user) { %>
        <nav class="nav-row" id="main-nav" aria-label="Main">
          <div class="nav-inner">
            <a class="nav-link" href="/">Dashboard</a>
            <a class="nav-link" href="/chats">Chats</a>
            <a class="nav-link" href="/qr">Link</a>
            <a class="nav-link" href="/settings">Settings</a>
            <a class="nav-link" href="/notifications">Notifications</a>
            <a class="nav-link" href="/logs">Logs</a>
            <a class="nav-link" href="/ignored">Ignored</a>
            <a class="nav-link" href="/history">History</a>
          </div>
        </nav>
        <script>
          (function () {
            const toggle = document.getElementById('nav-toggle');
            const nav = document.getElementById('main-nav');
            if (!toggle || !nav) return;
            toggle.addEventListener('click', () => {
              const open = toggle.getAttribute('aria-expanded') === 'true';
              toggle.setAttribute('aria-expanded', String(!open));
              nav.classList.toggle('open', !open);
            });
          })();
        </script>
      <% } %>
    </header>
    <main>
      <%- body %>
    </main>
    <% if (user) { %>
      <nav class="tabbar" aria-label="Mobile navigation" role="tablist">
        <a class="tab" href="/" data-tab="home" aria-label="Home" role="tab">
          <svg class="tab-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
          <span>Home</span>
        </a>
        <a class="tab" href="/chats" data-tab="chats" aria-label="Chats" role="tab">
          <svg class="tab-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"/><path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z"/></svg>
          <span>Chats</span>
        </a>
        <a class="tab" href="/settings" data-tab="settings" aria-label="Settings" role="tab">
          <svg class="tab-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.836 1.372.734 2.942-.948 2.286-.597-.61-1.538-.61-2.135 0-.836 1.372-2.942.734-2.106-2.106.836-1.372-.734-2.942-.948-2.286a1.532 1.532 0 01-2.286-.948c-.836-1.372.734-2.942 2.106-2.106.836 1.372 2.942.734 2.286.948zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
          <span>Settings</span>
        </a>
      </nav>
    <% } %>
    <div id="toast-container"></div>
  </div>
  <div id="install-banner" class="install-banner mobile-only" style="display:none" role="banner" aria-label="Install app">
    <div class="install-banner-main">
      <p id="install-text">Add Respondr to your home screen for the best experience.</p>
      <div class="install-banner-actions">
        <button id="install-cta" class="btn btn-primary" type="button">Install</button>
        <button id="install-show-how" class="btn btn-ghost" type="button" style="display:none">Show me how</button>
        <button id="install-dismiss" class="btn btn-ghost" type="button" aria-label="Dismiss">×</button>
      </div>
    </div>
    <div id="install-instructions" class="install-instructions" style="display:none">
      <ol>
        <li>Tap the <strong>Share</strong> icon in Safari’s toolbar.</li>
        <li>Scroll and tap <strong>Add to Home Screen</strong>.</li>
        <li>Tap <strong>Add</strong>.</li>
      </ol>
      <button id="install-instructions-close" class="btn btn-ghost" type="button">Close</button>
    </div>
  </div>

  <script src="/static/status.js?v=4"></script>
  <script src="/static/app.js?v=3"></script>
</body>
</html>
