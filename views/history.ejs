<div class="page-header">
  <h2>History</h2>
  <p>Past reminders and scans</p>
</div>

<div class="card">
  <h3>Reminders</h3>
  <% if (reminders.length === 0) { %>
    <p class="muted">No reminders yet.</p>
  <% } else { %>
    <ul class="activity-list">
      <% reminders.forEach(r => { %>
        <li>
          <span class="activity-title"><%= r.chat_name %></span>
          <span class="activity-time"><%= new Date(r.sent_at).toLocaleString() %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="card">
  <h3>Scan logs</h3>
  <% if (scans.length === 0) { %>
    <p class="muted">No scan logs yet.</p>
  <% } else { %>
    <ul class="activity-list">
      <% scans.forEach(s => { %>
        <li>
          <span class="activity-title"><%= new Date(s.run_at).toLocaleString() %></span>
          <span class="activity-time">checked <%= s.chats_checked %>, sent <%= s.reminders_sent %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
